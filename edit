import type { AdoTestSuite } from '../types/ado';
import type { AdoTestPoint } from './adoApi';
import { getTestPoints } from './adoApi';

export interface QaMetrics {
    total: number;
    passed: number;
    failed: number;
    blocked: number;
    pending: number;
    notApplicable: number;
    inProgress: number;
    otherCompleted: number;
    unknown: number;
    executed: number;
    executionRate: number;
    passRate: number;
}

export function getAllSuiteIds(
    suites: AdoTestSuite[]
): number[] {
    const ids = new Set<number>();

    function visit(suite: AdoTestSuite) {
        if (ids.has(suite.id)) return;

        ids.add(suite.id);

        for (const child of suite.children ?? []) {
            visit(child);
        }
    }

    suites.forEach(visit);
    return [...ids];
}

export async function loadPlanMetrics(
    planId: number,
    suites: AdoTestSuite[],
    signal?: AbortSignal
): Promise<QaMetrics> {
    const suiteIds = getAllSuiteIds(suites);
    const allPoints: AdoTestPoint[] = [];
    const batchSize = 5;

    for (let index = 0; index < suiteIds.length; index += batchSize) {
        signal?.throwIfAborted();

        const batch = suiteIds.slice(index, index + batchSize);

        const results = await Promise.all(
            batch.map(suiteId =>
                getTestPoints(planId, suiteId, signal)
            )
        );

        for (const points of results) {
            allPoints.push(...points);
        }
    }

    return calculateQaMetrics(allPoints);
}

export function calculateQaMetrics(
    points: AdoTestPoint[]
): QaMetrics {
    const uniquePoints = new Map(
        points.map(point => [point.id, point])
    );

    const metrics: QaMetrics = {
        total: uniquePoints.size,
        passed: 0,
        failed: 0,
        blocked: 0,
        pending: 0,
        notApplicable: 0,
        inProgress: 0,
        otherCompleted: 0,
        unknown: 0,
        executed: 0,
        executionRate: 0,
        passRate: 0,
    };

    for (const point of uniquePoints.values()) {
        const outcome = point.results?.outcome?.toLowerCase();

        switch (outcome) {
            case 'passed':
                metrics.passed++;
                break;

            case 'failed':
                metrics.failed++;
                break;

            case 'blocked':
                metrics.blocked++;
                break;

            case 'notapplicable':
                metrics.notApplicable++;
                break;

            case 'inprogress':
            case 'paused':
                metrics.inProgress++;
                break;

            case 'none':
            case 'notexecuted':
                metrics.pending++;
                break;

            case 'inconclusive':
            case 'timeout':
            case 'aborted':
            case 'error':
                metrics.otherCompleted++;
                break;

            default:
                metrics.unknown++;
                break;
        }
    }

    // Policy: blocked and N/A do not count as executed.
    // Other completed outcomes represent completed attempts.
    metrics.executed =
        metrics.passed +
        metrics.failed +
        metrics.otherCompleted;

    // Policy: N/A points are excluded from the progress denominator.
    const applicablePoints =
        metrics.total - metrics.notApplicable;

    metrics.executionRate = applicablePoints > 0
        ? (metrics.executed / applicablePoints) * 100
        : 0;

    metrics.passRate = metrics.executed > 0
        ? (metrics.passed / metrics.executed) * 100
        : 0;

    return metrics;
}
