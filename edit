import * as SDK from 'azure-devops-extension-sdk';
import type {
    AdoTestSuite,
    AdoTestSuiteResponse,
} from '../types/ado';

const ORGANIZATION = 'axaiuk-axaazureforge';
const PROJECT = 'Sandpiper';

export interface AdoTestPlan {
    id: number;
    name: string;
}

export interface AdoTestPoint {
    id: number;

    testCaseReference?: {
        id: number;
        name: string;
    };

    configuration?: {
        id: number;
        name: string;
    };

    results?: {
        outcome?: string;
        state?: string;
        lastResultId?: number;
        lastTestRunId?: number;
        lastResultDetails?: {
            dateCompleted?: string;
            duration?: number;
            runBy?: {
                displayName?: string;
            };
        };
    };
}

interface AdoListResponse<T> {
    value: T[];
    count?: number;
}

async function getAllPages<T>(
    path: string,
    signal?: AbortSignal
): Promise<T[]> {
    await SDK.ready();

    const accessToken = await SDK.getAccessToken();
    const items: T[] = [];
    const seenTokens = new Set<string>();
    let continuationToken: string | null = null;

    do {
        const url = new URL(
            `https://dev.azure.com/${ORGANIZATION}/` +
            `${encodeURIComponent(PROJECT)}/_apis/testplan/${path}`
        );

        url.searchParams.set('api-version', '7.1');

        if (continuationToken) {
            url.searchParams.set(
                'continuationToken',
                continuationToken
            );
        }

        const response = await fetch(url, {
            signal,
            headers: {
                Authorization: `Bearer ${accessToken}`,
                Accept: 'application/json',
            },
        });

        if (!response.ok) {
            throw new Error(
                `Azure DevOps request failed: ${response.status}`
            );
        }

        const data = await response.json() as AdoListResponse<T>;

        if (!Array.isArray(data.value)) {
            throw new Error('Unexpected Azure DevOps response.');
        }

        items.push(...data.value);

        continuationToken =
            response.headers.get('x-ms-continuationtoken');

        if (continuationToken) {
            if (seenTokens.has(continuationToken)) {
                throw new Error(
                    'Azure DevOps returned a repeated pagination token.'
                );
            }

            seenTokens.add(continuationToken);
        }
    } while (continuationToken);

    return items;
}

export async function getTestPlans(
    signal?: AbortSignal
): Promise<AdoTestPlan[]> {
    const plans = await getAllPages<AdoTestPlan>('plans', signal);

    return [...new Map(
        plans.map(plan => [plan.id, plan])
    ).values()];
}

export async function getTestSuites(
    planId: number,
    signal?: AbortSignal
): Promise<AdoTestSuiteResponse> {
    // Request flat suites; build the tree after all pages arrive.
    const suites = await getAllPages<AdoTestSuite>(
        `Plans/${planId}/suites`,
        signal
    );

    const nodes = new Map<number, AdoTestSuite>();

    for (const suite of suites) {
        nodes.set(suite.id, {
            ...suite,
            children: [],
        });
    }

    const roots: AdoTestSuite[] = [];

    for (const node of nodes.values()) {
        const parentId = node.parentSuite?.id;
        const parent = parentId == null
            ? undefined
            : nodes.get(parentId);

        if (parent && parent.id !== node.id) {
            parent.children!.push(node);
        } else {
            roots.push(node);
        }
    }

    return {
        value: roots,
        count: nodes.size,
    };
}

export async function getTestPoints(
    planId: number,
    suiteId: number,
    signal?: AbortSignal
): Promise<AdoTestPoint[]> {
    const points = await getAllPages<AdoTestPoint>(
        `Plans/${planId}/Suites/${suiteId}/TestPoint`,
        signal
    );

    return [...new Map(
        points.map(point => [point.id, point])
    ).values()];
}
